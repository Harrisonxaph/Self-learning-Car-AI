{
  "name": "self-driving-ai-evolution",
  "version": "0.0.0",
  "private": true,
  "description": "Browser sandbox where 2D cars learn to drive through neural networks evolved by a genetic algorithm.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:golden:update": "vitest run tests/sim/golden.test.ts --mode golden-update",
    "demo:vehicle": "vitest run tests/sim/vehicleDemo.test.ts --silent=false --reporter=verbose",
    "demo:collision": "vitest run tests/sim/collisionDemo.test.ts --silent=false --reporter=verbose",
    "demo:laps": "vitest run tests/sim/lapDemo.test.ts --silent=false --reporter=verbose"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
